SHAPE_REPOSITORY_URL=https://shapes.activitypods.org/

# Read by the Vite app (src/providers.ts): offered as the only Pod provider on the login page,
# instead of fetching the public list from https://activitypods.org/data/pod-providers. Matches
# the local Pod provider started by `docker compose up` (see docker-compose.yml).
VITE_POD_PROVIDER_URL=http://localhost:3000
